# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# Every variable the service reads is listed here. The two without a default are required:
# the app refuses to start without them.

# --- required ---------------------------------------------------------------------
# The API connects as the least-privilege role from migrations/003_app_role.sql, never as the
# admin user. Locally, set its password once:
#   docker compose exec db psql -U pulse -d pulsestore -c "ALTER ROLE pulse_app PASSWORD 'pulse-app-local'"
DATABASE_URL=postgresql://pulse_app:pulse-app-local@localhost:5432/pulsestore
# Required on every endpoint except /healthz. Must not be empty: an empty key would accept an
# empty x-api-key header. In Azure this is a Container Apps secret, not a literal.
API_KEY=dev-key

# --- optional, shown with their defaults --------------------------------------------
# password: the password is in DATABASE_URL (local, CI, and the deployed app).
# entra:    no password; each connection uses a fresh Entra token (docs/azure.md).
DB_AUTH=password
DB_POOL_MAX=10
# How long GET /stats/beat-distribution (without recording_id) may serve stale counts.
# Per replica, cleared by any ingest. 0 switches the cache off.
DISTRIBUTION_CACHE_SECONDS=30
# Set only in Azure. When absent, the app never imports the Azure packages and /healthz
# reports "telemetry": false.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- scripts, not the service --------------------------------------------------------
# Admin connection, only for migrations and scripts/bench_*.py (they create and drop indexes).
ADMIN_DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulsestore
# scripts/load_mitbih.py: where to post, and where the downloaded MIT-BIH records live.
API_URL=http://localhost:8000
MITDB_DIR=data/mitdb
