# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# The API connects as the least-privilege role from migrations/003_app_role.sql, never as the
# admin user. Locally, set its password once:
#   docker compose exec db psql -U pulse -d pulsestore -c "ALTER ROLE pulse_app PASSWORD 'pulse-app-local'"
DATABASE_URL=postgresql://pulse_app:pulse-app-local@localhost:5432/pulsestore
API_KEY=dev-key
DB_POOL_MAX=10

# Admin connection, only for migrations and scripts/bench_*.py (they create and drop indexes).
ADMIN_DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulsestore
